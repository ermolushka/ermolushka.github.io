---
interface Props {
  src: string;
  caption?: string;
  height?: number;
  title?: string;
}

const { src, caption, height = 420, title } = Astro.props;
---

<figure class="blog-figure">
  <div class="figure-frame" style={`height: ${height}px`}>
    <iframe src={src} title={title || caption || "Interactive figure"} loading="lazy" scrolling="no" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-figure {
    margin: 2.5rem 0;
  }
  .figure-frame {
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgb(var(--color-border));
    background: #0d1117;
    position: relative;
  }
  .figure-frame::before {
    content: "figure";
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.2);
    pointer-events: none;
    z-index: 1;
  }
  .figure-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  figcaption {
    text-align: center;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    opacity: 0.45;
    font-family: "IBM Plex Mono", monospace;
    font-style: italic;
    letter-spacing: 0.01em;
  }
</style>
