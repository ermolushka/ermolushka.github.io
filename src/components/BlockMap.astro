---
import type { CollectionEntry } from "astro:content";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const COLS = 16;
const WORDS_PER_BLOCK = 150;

// seeded PRNG so the layout is the same on every build
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(2718);

const seqs = posts.map((post) => ({
  href: `/posts/${post.slug}/`,
  title: post.data.title,
  blocks: Math.max(
    2,
    Math.ceil((post.body ?? "").split(/\s+/).length / WORDS_PER_BLOCK),
  ),
}));

// split every post into runs of 1-4 blocks, like a paged allocator would
const runs: { seq: number; len: number }[] = [];
seqs.forEach((s, seq) => {
  let left = s.blocks;
  while (left > 0) {
    const len = Math.min(left, 1 + Math.floor(rand() * 4));
    runs.push({ seq, len });
    left -= len;
  }
});
for (let i = runs.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [runs[i], runs[j]] = [runs[j], runs[i]];
}

const used = seqs.reduce((n, s) => n + s.blocks, 0);
const total = Math.ceil((used * 1.3) / COLS) * COLS;
const cells: (number | null)[] = [];
for (const run of runs) {
  // leave the occasional hole between runs
  if (rand() < 0.3 && cells.length + run.len + 1 < total) cells.push(null);
  for (let k = 0; k < run.len; k++) cells.push(run.seq);
}
while (cells.length < total) cells.push(null);
---

<div
  class="block-map"
  style={`--cols:${COLS}`}
  data-total={total}
  data-used={used}
  data-posts={seqs.length}
>
  <div class="grid" aria-hidden="true">
    {
      cells.map((owner, i) =>
        owner === null ? (
          <span class="cell free" style={`--i:${i}`} />
        ) : (
          <a
            class={`cell t${owner % 4}`}
            href={seqs[owner].href}
            tabindex="-1"
            data-href={seqs[owner].href}
            data-title={seqs[owner].title}
            data-blocks={seqs[owner].blocks}
            style={`--i:${i}`}
          />
        )
      )
    }
  </div>
  <p class="readout" aria-live="polite">
    <span class="readout-text"></span>
  </p>
</div>

<style>
  .block-map {
    --gap: 4px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gap);
  }
  @media (max-width: 640px) {
    .block-map {
      --gap: 3px;
    }
  }
  .cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 1px;
    background: rgba(var(--color-accent), 0.38);
    box-shadow: inset 0 0 0 1px rgba(var(--color-accent), 0.5);
    transition:
      background-color 120ms,
      box-shadow 120ms,
      opacity 120ms;
    animation: allocate 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 7ms);
  }
  .cell.t1 {
    background: rgba(var(--color-text-base), 0.5);
    box-shadow: inset 0 0 0 1px rgba(var(--color-text-base), 0.6);
  }
  .cell.t2 {
    background: rgba(var(--color-accent), 0.7);
    box-shadow: inset 0 0 0 1px rgba(var(--color-accent), 0.8);
  }
  .cell.t3 {
    background: rgba(var(--color-text-base), 0.25);
    box-shadow: inset 0 0 0 1px rgba(var(--color-text-base), 0.35);
  }
  .cell.free {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(var(--color-border));
  }
  .grid.has-focus .cell:not(.free):not(.on) {
    opacity: 0.35;
  }
  .cell.on {
    background: rgb(var(--color-accent));
    box-shadow: inset 0 0 0 1px rgb(var(--color-accent));
  }
  @keyframes allocate {
    from {
      background: transparent;
      box-shadow: inset 0 0 0 1px rgb(var(--color-border));
    }
    60% {
      background: rgb(var(--color-text-base));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cell {
      animation: none;
    }
  }
  .readout {
    margin-top: 0.75rem;
    min-height: 1.5rem;
    font-family: "Martian Mono", "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    opacity: 0.9;
  }
</style>

<script>
  function initBlockMap() {
    const map = document.querySelector<HTMLElement>(".block-map");
    if (!map) return;
    const grid = map.querySelector<HTMLElement>(".grid")!;
    const readout = map.querySelector<HTMLElement>(".readout-text")!;
    const cells = [...map.querySelectorAll<HTMLElement>(".cell[data-href]")];
    const rows = [...document.querySelectorAll<HTMLElement>("[data-post-row]")];

    const idle = `${map.dataset.posts} posts hold ${map.dataset.used} of ${map.dataset.total} blocks. One block is roughly 150 words.`;
    readout.textContent = idle;

    function focus(href: string | null) {
      grid.classList.toggle("has-focus", !!href);
      cells.forEach((c) => c.classList.toggle("on", c.dataset.href === href));
      rows.forEach((r) =>
        r.classList.toggle("on", !!href && r.dataset.postRow === href),
      );
      if (!href) {
        readout.textContent = idle;
        return;
      }
      const c = cells.find((c) => c.dataset.href === href)!;
      readout.textContent = `${c.dataset.title}: ${c.dataset.blocks} blocks, not contiguous`;
    }

    cells.forEach((c) => {
      c.addEventListener("mouseenter", () => focus(c.dataset.href!));
      c.addEventListener("mouseleave", () => focus(null));
    });
    rows.forEach((r) => {
      const open = () => focus(r.dataset.postRow!);
      r.addEventListener("mouseenter", open);
      r.addEventListener("mouseleave", () => focus(null));
      r.addEventListener("focusin", open);
      r.addEventListener("focusout", () => focus(null));
    });
  }
  initBlockMap();
  document.addEventListener("astro:after-swap", initBlockMap);
</script>
