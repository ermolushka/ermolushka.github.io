---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import BlockMap from "@components/BlockMap.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { HERO, SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter((social) => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>ermolushka</h1>
      <p class="lede">{HERO.intro}</p>
      {
        HERO.now && (
          <p class="now">
            <span class="now-dot" aria-hidden="true" />
            Building {HERO.now}
          </p>
        )
      }
      <BlockMap posts={sortedPosts} />
      <div class="social-wrapper">
        <Socials />
        <a href="/rss.xml" class="rss-link" aria-label="RSS feed">rss</a>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Featured</h2>
            <ul class="post-list">
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul class="post-list">
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                ),
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero ===== */
  #hero {
    @apply pb-6 pt-10;
  }
  #hero h1 {
    @apply mb-4 text-[clamp(2.25rem,8.5vw,4.5rem)] font-light leading-none;
    font-stretch: 100%;
    letter-spacing: -0.06em;
  }
  #hero .lede {
    @apply mb-6 max-w-[34rem] text-xl;
  }
  #hero .now {
    @apply mb-8 flex items-center gap-2 font-mono text-sm opacity-80;
  }
  .now-dot {
    @apply inline-block h-2 w-2 shrink-0 rounded-full bg-skin-accent;
    animation: breathe 2.4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot {
      animation: none;
    }
  }
  .social-wrapper {
    @apply mt-6 flex items-center gap-4;
  }
  .rss-link {
    @apply font-mono text-sm underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }

  /* ===== Post lists ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-10;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-lg font-semibold;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
